generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("EDITOR") // ADMIN | EDITOR
  createdAt    DateTime @default(now())
}

model Category {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  kind       String // PROPERTY | ARTICLE
  sortOrder  Int        @default(0)
  properties Property[]
  articles   Article[]
}

model Property {
  id                 String          @id @default(cuid())
  slug               String          @unique
  name               String
  summary            String          @default("")
  description        String          @default("")
  city               String          @default("")
  state              String          @default("")
  address            String          @default("")
  propertyType       String          @default("") // Duplex, Apartment, Land, ...
  purpose            String          @default("RESIDENTIAL") // RESIDENTIAL | INVESTMENT
  categoryId         String?
  category           Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  price              Float? // Naira
  priceVerified      Boolean         @default(false)
  priceNote          String          @default("")
  availability       String          @default("AVAILABLE") // AVAILABLE | RESERVED | SOLD | COMING_SOON
  bedrooms           Int?
  bathrooms          Int?
  sizeSqm            Float?
  features           String          @default("[]") // JSON string[]
  documentationStatus String         @default("UNVERIFIED") // UNVERIFIED | IN_REVIEW | VERIFIED
  documentationNotes String          @default("")
  documentationVerifiedOn DateTime?
  featured           Boolean         @default(false)
  published          Boolean         @default(false)
  sortOrder          Int             @default(0)
  images             PropertyImage[]
  enquiries          Enquiry[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  alt        String   @default("")
  sortOrder  Int      @default(0)
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @default("")
  body        String    @default("") // lightweight markdown
  coverUrl    String    @default("")
  coverAlt    String    @default("")
  author      String    @default("Jorbe Samuel")
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  fileUrl     String
  fileSize    Int      @default(0)
  published   Boolean  @default(true)
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  topic     String  @default("General")
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model Enquiry {
  id         String    @id @default(cuid())
  name       String
  email      String
  phone      String    @default("")
  type       String    @default("General")
  location   String    @default("")
  budget     String    @default("")
  message    String
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  status     String    @default("NEW") // NEW | CONTACTED | CLOSED
  notes      String    @default("")
  createdAt  DateTime  @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Key/value site profile & contact settings (editable in admin)
model Setting {
  key   String @id
  value String @default("")
}
